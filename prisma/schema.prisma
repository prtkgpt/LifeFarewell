// LifeFarewell — Prisma Schema
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────
enum UseCase {
  BEREAVED
  PRENEED
}

enum ApprovalLevel {
  LEVEL_1_REVIEW_ALL
  LEVEL_2_AUTO_OUTREACH
  LEVEL_3_AUTO_EXECUTE_LIMITED
}

enum DisclosureMode {
  FULL
  MINIMAL
}

enum PipelineStage {
  DISCOVERY
  OUTREACH
  RESPONSES
  COMPARISON
  DECISION
}

enum MessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  DELIVERED
  FAILED
  SIMULATED
}

enum CallStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INITIATED
  IN_PROGRESS
  COMPLETED
  FAILED
  SIMULATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ApprovalType {
  EMAIL
  SMS
  CALL
  BOOKING
  PAYMENT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── AUTH MODELS ──────────────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  cases      Case[]
  plans      Plan[]
  auditLogs  AuditLog[]
  approvals  PendingApproval[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── ONBOARDING ───────────────────────────────────────────────────────
model OnboardingProfile {
  id                     String   @id @default(cuid())
  userId                 String
  useCase                UseCase
  relationship           String?
  city                   String?
  state                  String?
  dateOfDeath            DateTime?
  hasExistingFuneralHome Boolean  @default(false)
  immediateNeeds         String[]
  budgetTarget           Int?
  budgetMax              Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ─── CASE (PRIMARY) ──────────────────────────────────────────────────
model Case {
  id            String        @id @default(cuid())
  userId        String
  title         String
  pipelineStage PipelineStage @default(DISCOVERY)
  goalSummary   String?
  goalDeadline  DateTime?
  budgetTarget  Int?
  budgetMax     Int?
  city          String?
  state         String?
  sandboxMode   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user                User                     @relation(fields: [userId], references: [id])
  decedentProfile     DecedentProfile?
  communicationPolicy CommunicationPolicy?
  intakeSessions      CaseIntakeSession[]
  vendorShortlists    VendorShortlist[]
  quoteRequests       QuoteRequest[]
  conversationThreads VendorConversationThread[]
  emailMessages       EmailMessage[]
  smsMessages         SmsMessage[]
  calls               Call[]
  pendingApprovals    PendingApproval[]
  checklistItems      ChecklistItem[]
  executionRuns       ExecutionRun[]
  auditLogs           AuditLog[]
}

model DecedentProfile {
  id          String    @id @default(cuid())
  caseId      String    @unique
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  dateOfDeath DateTime?
  city        String?
  state       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CommunicationPolicy {
  id                 String         @id @default(cuid())
  caseId             String         @unique
  approvalLevel      ApprovalLevel  @default(LEVEL_1_REVIEW_ALL)
  disclosureMode     DisclosureMode @default(FULL)
  allowOutbound      Boolean        @default(true)
  allowEmail         Boolean        @default(true)
  allowSms           Boolean        @default(true)
  allowCalls         Boolean        @default(true)
  callingWindowStart String?
  callingWindowEnd   String?
  timezone           String         @default("America/Los_Angeles")
  contactFirstName   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseIntakeSession {
  id        String   @id @default(cuid())
  caseId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ─── VENDORS ─────────────────────────────────────────────────────────
model Vendor {
  id          String   @id @default(cuid())
  name        String
  category    String
  city        String
  state       String
  address     String?
  phone       String?
  email       String?
  website     String?
  rating      Float?
  priceRange  String?
  description String?
  services    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shortlists          VendorShortlist[]
  conversationThreads VendorConversationThread[]
  quoteRequests       QuoteRequest[]
}

model VendorShortlist {
  id        String   @id @default(cuid())
  caseId    String
  vendorId  String
  priority  Int      @default(0)
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([caseId, vendorId])
}

// ─── QUOTES & NORMALIZATION ──────────────────────────────────────────
model QuoteRequest {
  id         String    @id @default(cuid())
  caseId     String
  vendorId   String
  status     String    @default("pending")
  rawContent String?
  totalPrice Int?
  currency   String    @default("USD")
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  lineItems QuoteLineItem[]
}

model QuoteLineItem {
  id             String   @id @default(cuid())
  quoteRequestId String
  category       String
  description    String
  amount         Int
  isRequired     Boolean  @default(true)
  isFlagged      Boolean  @default(false)
  flagReason     String?
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
}

// ─── CONVERSATION THREADS ────────────────────────────────────────────
model VendorConversationThread {
  id        String   @id @default(cuid())
  caseId    String
  vendorId  String
  subject   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  emailMessages EmailMessage[]
  smsMessages   SmsMessage[]
  calls         Call[]
}

// ─── COMMUNICATIONS ──────────────────────────────────────────────────
model EmailMessage {
  id             String        @id @default(cuid())
  caseId         String
  threadId       String?
  toAddress      String
  fromAddress    String?
  subject        String
  body           String
  disclosureText String?
  status         MessageStatus @default(DRAFT)
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  case   Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  thread VendorConversationThread?  @relation(fields: [threadId], references: [id])
}

model SmsMessage {
  id             String        @id @default(cuid())
  caseId         String
  threadId       String?
  toNumber       String
  fromNumber     String?
  body           String
  disclosureText String?
  status         MessageStatus @default(DRAFT)
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  case   Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  thread VendorConversationThread?  @relation(fields: [threadId], references: [id])
}

model Call {
  id               String           @id @default(cuid())
  caseId           String
  threadId         String?
  toNumber         String
  fromNumber       String?
  script           String
  disclosureText   String?
  status           CallStatus       @default(DRAFT)
  providerCallSid  String?
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  recordingUrl     String?
  transcriptText   String?
  transcriptStatus TranscriptStatus @default(PENDING)
  ttsAudioUrl      String?
  ttsVoiceId       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  case   Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  thread VendorConversationThread?  @relation(fields: [threadId], references: [id])
}

// ─── APPROVALS ───────────────────────────────────────────────────────
model PendingApproval {
  id          String         @id @default(cuid())
  caseId      String
  userId      String
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  title       String
  summary     String?
  payload     Json
  referenceId String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// ─── CHECKLIST ───────────────────────────────────────────────────────
model ChecklistItem {
  id          String          @id @default(cuid())
  caseId      String?
  planId      String?
  scopeType   String
  title       String
  description String?
  category    String?
  sortOrder   Int             @default(0)
  status      ChecklistStatus @default(NOT_STARTED)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// ─── EXECUTION RUNS ──────────────────────────────────────────────────
model ExecutionRun {
  id        String    @id @default(cuid())
  caseId    String?
  planId    String?
  scopeType String
  status    String    @default("pending")
  summary   String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  caseId     String?
  planId     String?
  actorType  String   @default("SYSTEM")
  actionType String
  summary    String
  payload    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ─── BACKGROUND JOBS ─────────────────────────────────────────────────
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── TTS ASSETS ──────────────────────────────────────────────────────
model TtsAsset {
  id        String   @id @default(cuid())
  callId    String?
  text      String
  voiceId   String
  audioUrl  String?
  filePath  String?
  createdAt DateTime @default(now())
}

// ─── PLAN (SECONDARY — PRE-NEED) ────────────────────────────────────
model Plan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  status    String   @default("draft")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  preferences    PlanPreference[]
  checklistItems ChecklistItem[]
  executionRuns  ExecutionRun[]
}

model PlanPreference {
  id        String   @id @default(cuid())
  planId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}
